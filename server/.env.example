PORT=5000
# Optional if your network DNS cannot resolve Atlas SRV records:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_URI=mongodb://127.0.0.1:27017/campus-library?replicaSet=rs0
# For Atlas, replace the value above in server/.env with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<encoded-password>@<cluster-host>/campus-library?retryWrites=true&w=majority

CLIENT_URL=http://localhost:5173
MANAGEMENT_ENABLED=true
